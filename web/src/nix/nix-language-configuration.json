{
  "comments": {
    "lineComment": "#",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["${", "}"],
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": ["string"]
    },
    {
      "open": "''",
      "close": "''",
      "notIn": ["string", "comment"]
    },
    {
      "open": "/**",
      "close": " */",
      "notIn": ["string"]
    }
  ],
  "autoCloseBefore": ";:.,=}])>` \n\t\"",
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["<", ">"],
    ["\"", "\""],
    ["'", "'"],
    ["''", "''"],
    ["`", "`"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*#?region\\b",
      "end": "^\\s*#\\s*#?endregion\\b"
    }
  },
  "onEnterRules": [
    {
      "beforeText": "^.*\\blet\\s*$",
      "afterText": "\\s*in\\b.*$",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": "^.*\\bif\\s*$",
      "afterText": "\\s*then\\b.*$",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": "^.*\\bthen\\s*$",
      "afterText": "\\s*else\\b.*$",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": "^.*''\\s*$",
      "afterText": "\\s*''.*$",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": "^.*/\\*\\*\\s*$",
      "afterText": "\\s*\\*/.*$",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": "^.*(?:=|/\\*\\*|'')\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^.*\\b(?:let|with|if|then|else|rec|or|and|assert|inherit)\\s*$",
      "action": {
        "indent": "indent"
      }
    }
  ],
  "wordPattern": "(-?\\d*\\.\\d\\w*)|((~|[^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\<\\>\\/\\?\\s]+)/[^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\<\\>\\?\\s]+)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)"
}
